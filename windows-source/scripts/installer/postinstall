#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
[[ "$EUID" = 0 ]] || { echo 'WB-PMM installer must run as root' >&2; exit 1; }

[[ "${3:-/}" = / ]] || { echo 'WB-PMM installs only on the system volume' >&2; exit 1; }
source_helper="$(cd "$(dirname "$0")" && pwd -P)/installer-helper"
[[ -x "$source_helper" ]] || { echo 'Missing installer-helper' >&2; exit 1; }
console_uid="$(/usr/bin/stat -f '%u' /dev/console)" || exit 1
[[ "$console_uid" =~ ^[0-9]+$ ]] || { echo 'Invalid console UID' >&2; exit 1; }
if [[ "$console_uid" = 0 ]]; then
  echo 'No console user; Dock migration skipped. Open /Applications/WB-PMM.app after login.'
  exit 0
fi
console_user="$(/usr/bin/id -nu "$console_uid")" || { echo 'Console user unavailable' >&2; exit 1; }
[[ -n "$console_user" && "$console_user" != root ]] || { echo 'Invalid console user' >&2; exit 1; }
scratch="$(/usr/bin/mktemp -d /private/tmp/wbpmm-installer.XXXXXX)" || exit 1
cleanup() { status=$?; trap - EXIT; [[ ! -d "$scratch" ]] || /bin/rm -r "$scratch" || status=1; exit "$status"; }
trap cleanup EXIT
/bin/chmod 755 "$scratch"
/bin/cp "$source_helper" "$scratch/installer-helper"
/bin/chmod 755 "$scratch/installer-helper"
if ! /bin/launchctl asuser "$console_uid" /usr/bin/sudo -n -H -u "$console_user" "$scratch/installer-helper" dock; then
  echo 'WB-PMM.app was updated, but Dock migration failed. Open /Applications/WB-PMM.app and pin it manually.' >&2
  exit 1
fi
exit 0
